{#
/**
 * @file
 * Frontdesk multi-step registration form component.
 *
 * This component provides an interactive, multi-step registration experience
 * for DrupalCamp Vienna 2025 attendees.
 *
 * @param {object} text - All text content for the component
 */
#}

{# Set default text values - can be overridden by passing 'text' prop #}
{% set defaultText = {
  loading: {
    message: 'Processing...'
  },
  steps: {
    step1: {
      title: 'Choose Your Path',
      subtitle: 'In the world of web development...',
      choices: {
        ai: {
          label: 'AI-Powered',
          description: 'Embrace the future'
        },
        traditional: {
          label: 'Traditional',
          description: 'Trust in experience'
        },
        separator: 'OR'
      }
    },
    step2: {
      title: 'Welcome to DrupalCamp Vienna 2025!',
      subtitle: 'Let\'s get to know you better',
      fields: {
        username: {
          label: 'What\'s your Drupal.org username?',
          optional: '(Optional)',
          placeholder: 'your_drupal_username',
          hint: 'We\'ll fetch your profile information automatically if you provide it',
          error: 'We couldn\'t find that username on Drupal.org. Please check and try again, or skip to continue.'
        }
      },
      buttons: {
        back: '← Back',
        skip: 'Skip →',
        continue: 'Continue →'
      }
    },
    step3: {
      title: 'Is this information correct?',
      subtitle: 'We found your profile! Please verify the details below.',
      fields: {
        firstName: 'First Name:',
        lastName: 'Last Name:',
        email: 'Email:'
      },
      buttons: {
        edit: 'Edit Information',
        confirm: '✓ Looks Good!'
      }
    },
    step3b: {
      title: 'Update Your Information',
      subtitle: 'Please provide the correct details',
      fields: {
        firstName: {
          label: 'First Name *',
          placeholder: 'John'
        },
        lastName: {
          label: 'Last Name *',
          placeholder: 'Doe'
        },
        email: {
          label: 'Work Email *',
          placeholder: 'john.doe@example.com'
        }
      },
      buttons: {
        cancel: 'Cancel',
        save: 'Save & Continue →'
      }
    },
    step4: {
      title: 'Almost There!',
      subtitle: 'Tell us about your organization',
      fields: {
        company: {
          label: 'Company Name (Optional)',
          placeholder: 'Acme Corporation',
          hint: 'Who do you represent?'
        }
      },
      buttons: {
        back: '← Back',
        continue: 'Continue →'
      }
    },
    step5: {
      title: 'One Last Thing...',
      subtitle: 'We\'d love to hear your thoughts!',
      fields: {
        feedback: {
          label: 'What are you most excited about at DrupalCamp Vienna 2025?',
          placeholder: 'Share your thoughts, expectations, or questions...',
          hint: 'Optional, but we\'d love to know!'
        }
      },
      buttons: {
        back: '← Back',
        continue: 'Continue →'
      }
    },
    step6: {
      title: 'Want to know more about us?',
      subtitle: 'We\'d love to tell you more about what we do!',
      choices: {
        yes: {
          label: 'Yes',
          description: 'I\'d love to learn more'
        },
        no: {
          label: 'No',
          description: 'I\'m all set, thanks'
        },
        separator: 'OR'
      }
    },
    step7: {
      title: 'We\'ll Be Right With You!',
      subtitle: 'Someone from our team will join you shortly to tell you more about what we do.',
      coffee: {
        title: 'Please help yourself to a complimentary coffee!',
        location: 'Our coffee machine is located near the registration desk.'
      },
      waiting: {
        message: 'Someone will be with you in just a moment'
      },
      buttons: {
        registerAnother: 'Register Another Attendee'
      }
    },
    step8: {
      title: 'Thank You!',
      message: 'We look forward to seeing you around DrupalCon Vienna 2025!',
      buttons: {
        registerAnother: 'Start Over!'
      }
    }
  }
} %}

{# Merge with provided text prop (if any) #}
{% set text = defaultText|merge(text|default({})) %}

<div class="frontdesk-container" id="frontdesk-app">
  {# Loading overlay #}
  <div class="loading-overlay" id="loading-overlay">
    <div class="loading-spinner"></div>
    <p class="loading-text">{{ text.loading.message }}</p>
  </div>

  {# Progress indicator #}
  <div class="progress-bar">
    <div class="progress-fill" id="progress-fill"></div>
  </div>

  {# Step 1: AI Preference (Matrix-inspired) #}
  <div class="step active" id="step-1" data-step="1">
    <div class="matrix-container">
      <h1 class="step-title glitch" data-text="{{ text.steps.step1.title }}">{{ text.steps.step1.title }}</h1>
      <p class="step-subtitle">{{ text.steps.step1.subtitle }}</p>

      <div class="pill-choice">
        <button class="pill-button blue-pill" data-choice="ai">
          <div class="pill-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 48px; height: 48px;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" />
            </svg>
          </div>
          <div class="pill-label">{{ text.steps.step1.choices.ai.label }}</div>
          <div class="pill-description">{{ text.steps.step1.choices.ai.description }}</div>
        </button>

        <div class="pill-vs">{{ text.steps.step1.choices.separator }}</div>

        <button class="pill-button red-pill" data-choice="traditional">
          <div class="pill-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 48px; height: 48px;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 0 1-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 0 0 6.16-12.12A14.98 14.98 0 0 0 9.631 8.41m5.96 5.96a14.926 14.926 0 0 1-5.841 2.58m-.119-8.54a6 6 0 0 0-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 0 0-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 0 1-2.448-2.448 14.9 14.9 0 0 1 .06-.312m-2.24 2.39a4.493 4.493 0 0 0-1.757 4.306 4.493 4.493 0 0 0 4.306-1.758M16.5 9a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z" />
            </svg>
          </div>
          <div class="pill-label">{{ text.steps.step1.choices.traditional.label }}</div>
          <div class="pill-description">{{ text.steps.step1.choices.traditional.description }}</div>
        </button>
      </div>
    </div>
  </div>

  {# Step 2: Drupal.org Username #}
  <div class="step" id="step-2" data-step="2">
    <h2 class="step-title">{{ text.steps.step2.title }}</h2>
    <p class="step-subtitle">{{ text.steps.step2.subtitle }}</p>

    <div class="form-group">
      <label for="drupal-username" class="form-label">
        {{ text.steps.step2.fields.username.label }} <span class="optional-label">{{ text.steps.step2.fields.username.optional }}</span>
      </label>
      <input
        type="text"
        id="drupal-username"
        class="form-input"
        placeholder="{{ text.steps.step2.fields.username.placeholder }}"
        autocomplete="off"
      />
      <p class="form-hint">{{ text.steps.step2.fields.username.hint }}</p>
      <div class="error-hint" id="username-error-hint" style="display: none;">
        <p class="error-hint-text">{{ text.steps.step2.fields.username.error }}</p>
      </div>
    </div>

    <div class="button-group">
      <button class="btn btn-secondary" id="back-to-step-1">{{ text.steps.step2.buttons.back }}</button>
      <button class="btn btn-tertiary" id="skip-username" style="display: none;">{{ text.steps.step2.buttons.skip }}</button>
      <button class="btn btn-primary" id="submit-username">{{ text.steps.step2.buttons.continue }}</button>
    </div>
  </div>

  {# Step 3: Confirm User Information #}
  <div class="step" id="step-3" data-step="3">
    <h2 class="step-title">{{ text.steps.step3.title }}</h2>
    <p class="step-subtitle">{{ text.steps.step3.subtitle }}</p>

    <div class="info-card" id="user-info-display">
      <div class="info-item">
        <span class="info-label">{{ text.steps.step3.fields.firstName }}</span>
        <span class="info-value" id="display-firstname">-</span>
      </div>
      <div class="info-item">
        <span class="info-label">{{ text.steps.step3.fields.lastName }}</span>
        <span class="info-value" id="display-lastname">-</span>
      </div>
      <div class="info-item">
        <span class="info-label">{{ text.steps.step3.fields.email }}</span>
        <span class="info-value" id="display-email">-</span>
      </div>
    </div>

    <div class="button-group">
      <button class="btn btn-secondary" id="edit-info-btn">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 18px; height: 18px; display: inline-block; vertical-align: middle; margin-right: 6px;">
          <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
        </svg>
        {{ text.steps.step3.buttons.edit }}
      </button>
      <button class="btn btn-primary" id="confirm-info-btn">{{ text.steps.step3.buttons.confirm }}</button>
    </div>
  </div>

  {# Step 3b: Edit User Information (shown if user needs to correct) #}
  <div class="step" id="step-3b" data-step="3">
    <h2 class="step-title">{{ text.steps.step3b.title }}</h2>
    <p class="step-subtitle">{{ text.steps.step3b.subtitle }}</p>

    <div class="form-group">
      <label for="edit-firstname" class="form-label">{{ text.steps.step3b.fields.firstName.label }}</label>
      <input
        type="text"
        id="edit-firstname"
        class="form-input"
        placeholder="{{ text.steps.step3b.fields.firstName.placeholder }}"
        required
      />
    </div>

    <div class="form-group">
      <label for="edit-lastname" class="form-label">{{ text.steps.step3b.fields.lastName.label }}</label>
      <input
        type="text"
        id="edit-lastname"
        class="form-input"
        placeholder="{{ text.steps.step3b.fields.lastName.placeholder }}"
        required
      />
    </div>

    <div class="form-group">
      <label for="edit-email" class="form-label">{{ text.steps.step3b.fields.email.label }}</label>
      <input
        type="email"
        id="edit-email"
        class="form-input"
        placeholder="{{ text.steps.step3b.fields.email.placeholder }}"
        required
      />
    </div>

    <div class="button-group">
      <button class="btn btn-secondary" id="cancel-edit-btn">{{ text.steps.step3b.buttons.cancel }}</button>
      <button class="btn btn-primary" id="save-info-btn">{{ text.steps.step3b.buttons.save }}</button>
    </div>
  </div>

  {# Step 4: Company Name #}
  <div class="step" id="step-4" data-step="4">
    <h2 class="step-title">{{ text.steps.step4.title }}</h2>
    <p class="step-subtitle">{{ text.steps.step4.subtitle }}</p>

    <div class="form-group">
      <label for="company-name" class="form-label">{{ text.steps.step4.fields.company.label }}</label>
      <input
        type="text"
        id="company-name"
        class="form-input"
        placeholder="{{ text.steps.step4.fields.company.placeholder }}"
      />
      <p class="form-hint">{{ text.steps.step4.fields.company.hint }}</p>
    </div>

    <div class="button-group">
      <button class="btn btn-secondary" id="back-to-step-3">{{ text.steps.step4.buttons.back }}</button>
      <button class="btn btn-primary" id="submit-company">{{ text.steps.step4.buttons.continue }}</button>
    </div>
  </div>

  {# Step 5: Feedback #}
  <div class="step" id="step-5" data-step="5">
    <h2 class="step-title">{{ text.steps.step5.title }}</h2>
    <p class="step-subtitle">{{ text.steps.step5.subtitle }}</p>

    <div class="form-group">
      <label for="feedback" class="form-label">
        {{ text.steps.step5.fields.feedback.label }}
      </label>
      <textarea
        id="feedback"
        class="form-textarea"
        placeholder="{{ text.steps.step5.fields.feedback.placeholder }}"
        rows="5"
      ></textarea>
      <p class="form-hint">{{ text.steps.step5.fields.feedback.hint }}</p>
    </div>

    <div class="button-group">
      <button class="btn btn-secondary" id="back-to-step-4">{{ text.steps.step5.buttons.back }}</button>
      <button class="btn btn-primary btn-large" id="submit-feedback">{{ text.steps.step5.buttons.continue }}</button>
    </div>
  </div>

  {# Step 6: Want to know more? #}
  <div class="step" id="step-6" data-step="6">
    <h2 class="step-title">{{ text.steps.step6.title }}</h2>
    <p class="step-subtitle">{{ text.steps.step6.subtitle }}</p>

    <div class="pill-choice" style="margin-top: 40px;">
      <button class="pill-button blue-pill" id="want-more-yes" data-choice="yes" style="max-width: 300px;">
        <div class="pill-icon">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 48px; height: 48px;">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.633 10.25c.806 0 1.533-.446 2.031-1.08a9.041 9.041 0 0 1 2.861-2.4c.723-.384 1.35-.956 1.653-1.715a4.498 4.498 0 0 0 .322-1.672V2.75a.75.75 0 0 1 .75-.75 2.25 2.25 0 0 1 2.25 2.25c0 1.152-.26 2.243-.723 3.218-.266.558.107 1.282.725 1.282m0 0h3.126c1.026 0 1.945.694 2.054 1.715.045.422.068.85.068 1.285a11.95 11.95 0 0 1-2.649 7.521c-.388.482-.987.729-1.605.729H13.48c-.483 0-.964-.078-1.423-.23l-3.114-1.04a4.501 4.501 0 0 0-1.423-.23H5.904m10.598-9.75H14.25M5.904 18.5c.083.205.173.405.27.602.197.4-.078.898-.523.898h-.908c-.889 0-1.713-.518-1.972-1.368a12 12 0 0 1-.521-3.507c0-1.553.295-3.036.831-4.398C3.387 9.953 4.167 9.5 5 9.5h1.053c.472 0 .745.556.5.96a8.958 8.958 0 0 0-1.302 4.665c0 1.194.232 2.333.654 3.375Z" />
          </svg>
        </div>
        <div class="pill-label">{{ text.steps.step6.choices.yes.label }}</div>
        <div class="pill-description">{{ text.steps.step6.choices.yes.description }}</div>
      </button>

      <div class="pill-vs">{{ text.steps.step6.choices.separator }}</div>

      <button class="pill-button red-pill" id="want-more-no" data-choice="no" style="max-width: 300px;">
        <div class="pill-icon">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 48px; height: 48px;">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.498 15.25H4.372c-1.026 0-1.945-.694-2.054-1.715a12.137 12.137 0 0 1-.068-1.285c0-2.848.992-5.464 2.649-7.521C5.287 4.247 5.886 4 6.504 4h4.016a4.5 4.5 0 0 1 1.423.23l3.114 1.04a4.5 4.5 0 0 0 1.423.23h1.294M7.498 15.25c.618 0 .991.724.725 1.282A7.471 7.471 0 0 0 7.5 19.75 2.25 2.25 0 0 0 9.75 22a.75.75 0 0 0 .75-.75v-.633c0-.573.11-1.14.322-1.672.304-.76.93-1.33 1.653-1.715a9.04 9.04 0 0 0 2.86-2.4c.498-.634 1.226-1.08 2.032-1.08h.384m-10.253 1.5H9.7m8.075-9.75c.01.05.027.1.05.148.593 1.2.925 2.55.925 3.977 0 1.487-.36 2.89-.999 4.125m.023-8.25c-.076-.365.183-.75.575-.75h.908c.889 0 1.713.518 1.972 1.368.339 1.11.521 2.287.521 3.507 0 1.553-.295 3.036-.831 4.398-.306.774-1.086 1.227-1.918 1.227h-1.053c-.472 0-.745-.556-.5-.96a8.95 8.95 0 0 0 .303-.54" />
          </svg>
        </div>
        <div class="pill-label">{{ text.steps.step6.choices.no.label }}</div>
        <div class="pill-description">{{ text.steps.step6.choices.no.description }}</div>
      </button>
    </div>
  </div>

  {# Step 7: Coffee Wait Screen #}
  <div class="step" id="step-7" data-step="7">
    <div class="coffee-wait-container">
      {# Coffee Machine Icon #}
      <div class="coffee-machine-wrapper">
        <div class="coffee-machine">
          <svg fill="#6F4E37" width="120px" height="120px" viewBox="0 0 50 50" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
            <path d="M13.46875 0C8.777344 0 4.9375 3.816406 4.9375 8.5C4.9375 13.183594 8.777344 17 13.46875 17L16 17L16 22L21 22L21 17L32 17L32 41L25.8125 41C26.140625 40.535156 26.464844 39.980469 26.78125 39.3125C27.992188 36.75 29 32.601563 29 26C29 25.449219 28.550781 25 28 25L9 25C8.96875 25 8.9375 25 8.90625 25C8.390625 25.046875 7.996094 25.480469 8 26C8 26.792969 8.003906 27.558594 8.03125 28.28125C7.585938 28.113281 7.078125 28 6.5 28C4.027344 28 2 30.027344 2 32.5C2 34.972656 4.027344 37 6.5 37L9.34375 37C9.617188 37.890625 9.90625 38.648438 10.21875 39.3125C10.535156 39.980469 10.859375 40.535156 11.1875 41L7.5 41C6.132813 41 5 42.132813 5 43.5L5 47.5C5 48.867188 6.132813 50 7.5 50L45.5 50C47.421875 50 49 48.421875 49 46.5L49 42C49.003906 41.949219 49.003906 41.894531 49 41.84375L44.4375 14.5625C46.019531 13.019531 47 10.871094 47 8.5C47 3.816406 43.160156 0 38.46875 0 Z M 13.46875 2L38.46875 2C42.082031 2 45 4.898438 45 8.5C45 12.101563 42.082031 15 38.46875 15L17.1875 15C17.054688 14.972656 16.914063 14.972656 16.78125 15L13.46875 15C9.855469 15 6.9375 12.101563 6.9375 8.5C6.9375 4.898438 9.855469 2 13.46875 2 Z M 42.625 15.90625L47 42.15625L47 46.5C47 47.339844 46.339844 48 45.5 48L7.5 48C7.214844 48 7 47.785156 7 47.5L7 43.5C7 43.214844 7.214844 43 7.5 43L33 43C33.550781 43 34 42.550781 34 42L34 17L38.46875 17C39.976563 17 41.394531 16.597656 42.625 15.90625 Z M 18 17L19 17L19 20L18 20 Z M 10.09375 27L26.90625 27C26.792969 32.6875 25.9375 36.386719 24.96875 38.4375C24.453125 39.53125 23.933594 40.214844 23.53125 40.59375C23.226563 40.878906 22.957031 40.972656 22.9375 41L14.0625 41C14.042969 40.972656 13.773438 40.878906 13.46875 40.59375C13.066406 40.214844 12.546875 39.53125 12.03125 38.4375C11.0625 36.386719 10.207031 32.6875 10.09375 27 Z M 6.5 30C7.308594 30 7.875 30.394531 8.21875 30.71875C8.363281 32.347656 8.574219 33.757813 8.84375 35L6.5 35C5.109375 35 4 33.890625 4 32.5C4 31.109375 5.109375 30 6.5 30 Z M 40 35C38.894531 35 38 35.894531 38 37C38 38.105469 38.894531 39 40 39C41.105469 39 42 38.105469 42 37C42 35.894531 41.105469 35 40 35Z"/>
          </svg>
        </div>
      </div>

      {# Main Content #}
      <div class="coffee-wait-content">
        <h2 class="coffee-wait-title">{{ text.steps.step7.title }}</h2>
        <p class="coffee-wait-message">
          {{ text.steps.step7.subtitle }}
        </p>

        {# Coffee Invitation #}
        <div class="coffee-invitation">
          <div class="coffee-invitation-icon">☕</div>
          <div class="coffee-invitation-text">
            <strong>{{ text.steps.step7.coffee.title }}</strong>
            <p class="coffee-direction">{{ text.steps.step7.coffee.location }}</p>
          </div>
        </div>

        {# Waiting Indicator #}
        <div class="waiting-indicator">
          <div class="waiting-dots">
            <span class="dot"></span>
            <span class="dot"></span>
            <span class="dot"></span>
          </div>
          <p class="waiting-text">{{ text.steps.step7.waiting.message }}</p>
        </div>
      </div>

      {# Register Another Button #}
      <button class="btn btn-primary" id="register-another-coffee">{{ text.steps.step7.buttons.registerAnother }}</button>
    </div>
  </div>

  {# Step 8: Success (No meeting) #}
  <div class="step" id="step-8" data-step="8">
    <div class="success-container">
      <div class="success-icon">✓</div>
      <h2 class="success-title">{{ text.steps.step8.title }}</h2>
      <p class="success-message">
        {{ text.steps.step8.message }}
      </p>
      <div class="success-animation">
        <div class="confetti"></div>
        <div class="confetti"></div>
        <div class="confetti"></div>
        <div class="confetti"></div>
        <div class="confetti"></div>
