{#
/**
 * @file
 * Drupal HTML template for Live Applause Widget
 *
 * This template provides the full HTML document structure for the Live Applause widget,
 * following Drupal best practices for HTML rendering.
 *
 * Available variables:
 * - attributes: HTML attributes for the html tag.
 * - page_title: The page title, for use in the actual content.
 * - head_title: Title for the <title> tag.
 * - head_title_array: List of text elements that make up the head_title.
 * - html_attributes: Same as attributes, except applied to the html tag.
 * - page_top: Initial markup from any modules.
 * - page: The rendered page markup.
 * - page_bottom: Closing markup from any modules.
 * - db_offline: A flag indicating if the database is offline.
 * - placeholder_token: The token for replacing the content of this placeholder.
 *
 * @see template_preprocess_html()
 */
#}
<!DOCTYPE html>
<html{{ html_attributes }}>
<head>
  <head-placeholder token="{{ placeholder_token }}">
    <title>{{ head_title|safe_join(' | ') }}</title>
    <css-placeholder token="{{ placeholder_token }}">
      <js-placeholder token="{{ placeholder_token }}">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <style>
          /* Full page layout styles for Live Applause */
          body {
            margin: 0;
            padding: 20px;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            color: #092963;
            position: relative;
          }

          *, *::before, *::after {
            box-sizing: inherit;
          }

          /* Compact widget for better layout */
          .live-applause-widget--fullscreen {
            height: auto;
            max-height: none;
            min-height: 500px;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            max-width: 500px;
            width: 100%;
            padding: 30px;
            background: #ffffff;
            border-radius: 8px;
            box-shadow: 0 4px 25px rgba(58, 188, 238, 0.1);
            margin-top: 20px;
          }

          /* Mobile responsive adjustments */
          @media (max-width: 768px) {
            body {
              padding: 10px;
            }
            
            .live-applause-widget--fullscreen {
              max-width: 100%;
              padding: 20px;
              margin-top: 10px;
              border-radius: 8px;
              min-height: 450px;
            }
          }
        </style>
</head>
<body{{ attributes.addClass('live-applause-page') }}>

  <div id="main-content" role="main">
    {% include 'vienna_2025_thumbs_up:live-applause' with {
      eventId: eventId,
      apiBase: apiBase,
      eventTitle: eventTitle,
      eventSubTitle: eventSubTitle,
      eventInfo: eventInfo,
      eventImageSrc: eventImageSrc,
      eventImageAlt: eventImageAlt,
      embedded: false,
      showConnectionStatus: true,
      enableBackgroundAnimation: true,
      clickCooldown: 100
    } only %}
  </div>
  <js-bottom-placeholder token="{{ placeholder_token }}">
  </body>
</html>
