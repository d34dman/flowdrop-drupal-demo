{#
/**
 * @file
 * Live Applause Widget Template
 *
 * Available variables:
 * - eventId: Unique identifier for the event
 * - apiBase: Base URL for the thumbs-up API
 * - eventTitle: Main title displayed in the widget
 * - eventSubTitle: Subtitle text displayed below the main title
 * - eventInfo: Additional event details
 * - eventImageSrc: URL for the event logo/image
 * - eventImageAlt: Alt text for the event image
 * - showConnectionStatus: Whether to display WebSocket connection status
 * - enableBackgroundAnimation: Whether to show floating emoji animations
 * - clickCooldown: Minimum time between clicks to prevent spam
 * - embedded: Whether to render in embedded mode (affects positioning)
 */
#}
{% set widget_classes = [
  'live-applause-widget',
  embedded ? 'live-applause-widget--embedded' : 'live-applause-widget--fullscreen'
] %}

{% set widget_settings = {
  eventId: eventId,
  apiBase: apiBase,
  clickCooldown: clickCooldown|default(100),
  enableBackgroundAnimation: enableBackgroundAnimation|default(true),
  showConnectionStatus: showConnectionStatus|default(true)
} %}

<div{{ attributes.addClass(widget_classes) }}
    data-live-applause-widget="{{ widget_settings|json_encode }}"
    role="application"
    aria-label="Live applause interactive widget for {{ eventTitle|default('event') }}">

  {% if showConnectionStatus %}
  <div class="live-applause-widget__connection-status live-applause-widget__connection-status--connecting{{ embedded ? ' live-applause-widget__connection-status--embedded' }}"
       role="status"
       aria-live="polite">
    <span class="sr-only">Connection status: </span>
    <span class="live-applause-widget__connection-status-indicator" aria-hidden="true"></span> Connecting...
  </div>
  {% endif %}

  <header class="live-applause-widget__header">
    {% if eventImageSrc %}
    <div class="live-applause-widget__logo-container">
      <img src="{{ eventImageSrc }}"
           alt="{{ eventImageAlt|default('Event logo') }}"
           class="live-applause-widget__logo">
    </div>
    {% endif %}

    <h1 class="live-applause-widget__title">{{ eventTitle|default('Live Applause! 👏') }}</h1>
    <p class="live-applause-widget__subtitle">{{ eventSubTitle|default('Real-Time Notifications Demo') }}</p>
    <p class="live-applause-widget__event-info">{{ eventInfo|default('Interactive Event') }}</p>
  </header>

  <main class="live-applause-widget__main-content">
    <button class="live-applause-widget__thumbs-button" 
            type="button"
            aria-label="Give thumbs up"
            aria-describedby="live-applause-instructions live-applause-my-clicks live-applause-total-clicks"
            aria-pressed="false">
      <span aria-hidden="true">👍</span>
      <span class="sr-only">Thumbs up button</span>
    </button>

    <div class="live-applause-widget__instructions" id="live-applause-instructions">
      <p>Tap the button to show your appreciation!</p>
      <p><small>Multiple taps welcome! <span aria-hidden="true">🎉</span></small></p>
    </div>
  </main>

  <aside class="live-applause-widget__stats" 
         role="region" 
         aria-label="Applause statistics"
         aria-live="polite">
    <div class="live-applause-widget__stat-item">
      <span class="live-applause-widget__stat-number" id="live-applause-my-clicks" aria-label="My thumbs up count">0</span>
      <span class="live-applause-widget__stat-label">My Thumbs Up</span>
    </div>
    <div class="live-applause-widget__stat-item">
      <span class="live-applause-widget__stat-number" id="live-applause-total-clicks" aria-label="Total community thumbs up count">0</span>
      <span class="live-applause-widget__stat-label">Total Thumbs Up</span>
    </div>
  </aside>

  <!-- Screen reader announcements -->
  <div id="live-applause-announcements" 
       class="sr-only" 
       aria-live="polite" 
       aria-atomic="true"
       role="status">
  </div>

  <!-- Urgent celebrations announcements -->
  <div id="live-applause-celebrations" 
       class="sr-only" 
       aria-live="assertive"
       aria-atomic="true"
       role="alert">
  </div>
</div>
