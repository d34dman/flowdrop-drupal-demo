{% set header %}
  {% if eyebrow %}<p class="fd-demo-section__eyebrow">{{ eyebrow }}</p>{% endif %}
  <h2 class="fd-section__title fd-demo-section__title"{% if id %} id="{{ id }}-title"{% endif %}>{{ title }}</h2>
  {% if description %}<p class="fd-section__description">{{ description }}</p>{% endif %}
{% endset %}
{% if collapsible %}
  <details class="fd-section fd-demo-section fd-demo-section--collapsible"{% if id %} id="{{ id }}"{% endif %}{% if open %} open{% endif %}>
    <summary class="fd-demo-section__header">
      <span class="fd-demo-section__heading">{{ header }}</span>
      <svg class="fd-demo-section__chevron" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.06l3.71-3.83a.75.75 0 111.08 1.04l-4.25 4.39a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd"/></svg>
    </summary>
    <div class="fd-demo-section__body">{{ content }}</div>
  </details>
{% else %}
  <section class="fd-section fd-demo-section"{% if id %} id="{{ id }}" aria-labelledby="{{ id }}-title"{% endif %}>
    <header class="fd-demo-section__header">{{ header }}</header>
    {{ content }}
  </section>
{% endif %}
