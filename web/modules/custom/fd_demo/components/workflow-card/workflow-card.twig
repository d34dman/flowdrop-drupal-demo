{#
/**
 * @file
 * A card for one workflow.
 */
#}
<article class="fd-demo-wf fd-demo-wf--card">
  <header class="fd-demo-wf__header">
    {% if icon %}<span class="fd-demo-wf__icon" aria-hidden="true">{{ icon|raw }}</span>{% endif %}
    <h3 class="fd-demo-wf__title">{{ title }}</h3>
  </header>
  {% if description %}<p class="fd-demo-wf__description">{{ description }}</p>{% endif %}
  {% if try_text or see_text %}
    <dl class="fd-demo-wf__hints">
      {% if try_text %}<div class="fd-demo-wf__hint"><dt>{{ "Try"|t }}</dt><dd>{{ try_text|raw }}</dd></div>{% endif %}
      {% if see_text %}<div class="fd-demo-wf__hint"><dt>{{ "You'll see"|t }}</dt><dd>{{ see_text|raw }}</dd></div>{% endif %}
    </dl>
  {% endif %}
  <div class="fd-demo-wf__footer">
    <div class="fd-demo-wf__meta">
      {% for need in needs %}
        {{ include("flowdrop_ui_components:pill", {label: need.label, variant: need.variant|default("neutral"), size: "sm"}, with_context = false) }}
      {% endfor %}
      {% if node_count %}
        <span class="fd-demo-wf__nodes">
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M3.5 2A1.5 1.5 0 002 3.5v3A1.5 1.5 0 003.5 8h3A1.5 1.5 0 008 6.5V6h4v.5A1.5 1.5 0 0013.5 8h3A1.5 1.5 0 0018 6.5v-3A1.5 1.5 0 0016.5 2h-3A1.5 1.5 0 0012 3.5V4H8v-.5A1.5 1.5 0 006.5 2h-3zM13.5 12a1.5 1.5 0 00-1.5 1.5v3a1.5 1.5 0 001.5 1.5h3a1.5 1.5 0 001.5-1.5v-3a1.5 1.5 0 00-1.5-1.5h-3z"/></svg>
          {{ node_count }} {{ node_count == 1 ? "node"|t : "nodes"|t }}
        </span>
      {% endif %}
    </div>
    {% if try_url or edit_url %}
      <div class="fd-demo-wf__actions">
        {% if edit_url %}
          <a href="{{ edit_url }}" class="fd-demo-btn fd-demo-btn--sm {{ try_url ? "fd-demo-btn--ghost" : "fd-demo-btn--secondary" }}" aria-label="{{ edit_label|default("Open editor") }}: {{ title }}">
            <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M2.695 14.763l-1.262 3.154a.5.5 0 00.65.65l3.155-1.262a4 4 0 001.343-.885L17.5 5.5a2.121 2.121 0 00-3-3L3.58 13.42a4 4 0 00-.885 1.343z"/></svg>
            {{ edit_label|default("Open editor") }}
          </a>
        {% endif %}
        {% if try_url %}
          <a href="{{ try_url }}" class="fd-demo-btn fd-demo-btn--sm fd-demo-btn--primary" aria-label="{{ try_label|default("Try it") }}: {{ title }}">
            <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M6.3 2.84A1.5 1.5 0 004 4.11v11.78a1.5 1.5 0 002.3 1.27l9.34-5.89a1.5 1.5 0 000-2.54L6.3 2.84z"/></svg>
            {{ try_label|default("Try it") }}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</article>
