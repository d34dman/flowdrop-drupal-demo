{#
/**
 * @file
 * The words a first-time visitor needs, beside the tour video.
 */
#}
<div class="fd-demo-concepts">
  <dl class="fd-demo-concepts__list">
    {% for item in items %}
      <div class="fd-demo-concepts__item">
        <dt class="fd-demo-concepts__term">
          {% if item.icon %}<span class="fd-demo-concepts__icon" aria-hidden="true">{{ item.icon|raw }}</span>{% endif %}
          <span>{{ item.term }}</span>
          {% if item.button %}<span class="fd-demo-concepts__button">{{ item.button }}</span>{% endif %}
        </dt>
        <dd class="fd-demo-concepts__text">{{ item.text|raw }}</dd>
      </div>
    {% endfor %}
  </dl>

  <figure class="fd-demo-concepts__tour">
    {% if tour_url %}
      <video class="fd-demo-concepts__video" src="{{ tour_url }}"{% if tour_poster %} poster="{{ tour_poster }}"{% endif %} controls muted playsinline preload="metadata"></video>
    {% else %}
      <div class="fd-demo-concepts__placeholder">
        {% if placeholder_label %}<span class="fd-demo-concepts__badge">{{ placeholder_label }}</span>{% endif %}
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M6.3 2.84A1.5 1.5 0 004 4.11v11.78a1.5 1.5 0 002.3 1.27l9.34-5.89a1.5 1.5 0 000-2.54L6.3 2.84z"/></svg>
        {% if placeholder_title %}<strong>{{ placeholder_title }}</strong>{% endif %}
        {% if placeholder_text %}<span>{{ placeholder_text }}</span>{% endif %}
      </div>
    {% endif %}
    {% if tour_caption %}<figcaption class="fd-demo-concepts__caption">{{ tour_caption }}</figcaption>{% endif %}
  </figure>
</div>
