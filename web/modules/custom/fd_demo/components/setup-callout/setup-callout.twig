{#
/**
 * @file
 * Setup callout: says whether a setup step is done, and how to do it if not.
 */
#}
{% set icons = {
  ok: '<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/>',
  missing: '<path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/>',
  info: '<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd"/>',
} %}
<div class="fd-demo-callout fd-demo-callout--{{ status }}" role="{{ status == 'ok' ? 'status' : 'note' }}">
  <svg class="fd-demo-callout__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">{{ icons[status]|raw }}</svg>
  <div class="fd-demo-callout__body">
    <p class="fd-demo-callout__title">{{ title }}</p>
    {% if message %}
      <p class="fd-demo-callout__message">{{ message|raw }}</p>
    {% endif %}
    {% if commands %}
      <div class="fd-demo-callout__terminal">
        <pre><code>{% for command in commands %}<span class="fd-demo-callout__line">{{ command }}</span>{{ not loop.last ? "\n" }}{% endfor %}</code></pre>
        <button type="button" class="fd-demo-btn fd-demo-btn--sm fd-demo-btn--secondary fd-demo-callout__copy"
          data-fd-demo-copy data-copied-label="{{ copied_label|default('Copied') }}">
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M7 3.5A1.5 1.5 0 018.5 2h3.879a1.5 1.5 0 011.06.44l3.122 3.12A1.5 1.5 0 0117 6.622V12.5a1.5 1.5 0 01-1.5 1.5h-1v-3.379a3 3 0 00-.879-2.121L10.5 5.379A3 3 0 008.379 4.5H7v-1z"/><path d="M4.5 6A1.5 1.5 0 003 7.5v9A1.5 1.5 0 004.5 18h7a1.5 1.5 0 001.5-1.5v-5.879a1.5 1.5 0 00-.44-1.06L9.44 6.439A1.5 1.5 0 008.378 6H4.5z"/></svg>
          <span>{{ copy_label|default('Copy') }}</span>
        </button>
      </div>
    {% endif %}
  </div>
</div>
