     return parent::getDerivativeDefinitions($base_array);
   }
 
+  /**
+   * Builds output definitions from a tool's MCP outputSchema.
+   *
+   * Each top-level property of the structuredContent object becomes one
+   * output, so a consumer can read `results` or `total` directly instead of
+   * parsing the text content.
+   *
+   * @param array<string, mixed> $output_schema
+   *   The tool's outputSchema; empty when the server declares none.
+   *
+   * @return array<string, \Drupal\tool\TypedData\OutputDefinitionInterface>
+   *   Output definitions keyed by property name.
+   */
+  protected function outputDefinitions(array $output_schema): array {
+    $properties = $output_schema['properties'] ?? [];
+    if (!is_array($properties)) {
+      return [];
+    }
+    $required = (array) ($output_schema['required'] ?? []);
+    $definitions = [];
+    foreach ($properties as $key => $info) {
+      if (is_array($info)) {
+        $definitions[$key] = $this->outputDefinition((string) $key, $info, in_array($key, $required, TRUE));
+      }
+    }
+    return $definitions;
+  }
+
+  /**
+   * Converts one JSON Schema node into an output definition.
+   *
+   * @param string $key
+   *   The property name, used when the schema has no title.
+   * @param array<string, mixed> $info
+   *   The JSON Schema of the property.
+   * @param bool $required
+   *   Whether the parent object lists the property as required.
+   *
+   * @return \Drupal\tool\TypedData\OutputDefinitionInterface
+   *   The output definition.
+   */
+  protected function outputDefinition(string $key, array $info, bool $required): OutputDefinitionInterface {
+    // Plain strings, not TranslatableMarkup: the text comes from a remote
+    // server and an '@' placeholder would HTML-escape it.
+    $label = (string) ($info['title'] ?? $key);
+    $description = (string) ($info['description'] ?? '');
+
+    switch (static::jsonSchemaType($info)) {
+      case 'array':
+        $items = is_array($info['items'] ?? NULL) ? $info['items'] : [];
+        return new ListOutputDefinition($label, $description, $required, FALSE, NULL, [], $this->outputDefinition($key, $items, FALSE));
+
+      case 'object':
+        $item_required = (array) ($info['required'] ?? []);
+        $properties = [];
+        foreach ((array) ($info['properties'] ?? []) as $name => $property) {
+          if (is_array($property)) {
+            $properties[$name] = $this->outputDefinition((string) $name, $property, in_array($name, $item_required, TRUE));
+          }
+        }
+        return new MapOutputDefinition($label, $description, $required, FALSE, NULL, [], $properties);
+
+      default:
+        $type = match (static::jsonSchemaType($info)) {
+          'number' => 'float',
+          'integer' => 'integer',
+          'boolean' => 'boolean',
+          default => 'string',
+        };
+        return new OutputDefinition($type, $label, $description, $required);
+    }
+  }
+
+  /**
+   * Resolves the JSON Schema type of a property.
+   *
+   * Handles a plain `type`, a type list such as ["string", "null"], and a
+   * `oneOf`/`anyOf` of alternatives, taking the first type that is not null.
+   *
+   * @param array<string, mixed> $info
+   *   The JSON Schema of the property.
+   *
+   * @return string
+   *   The type name, or 'string' when none can be found.
+   */
+  protected static function jsonSchemaType(array $info): string {
+    $type = $info['type'] ?? NULL;
+    if (is_string($type)) {
+      return $type;
+    }
+    if (is_array($type)) {
+      foreach ($type as $candidate) {
+        if (is_string($candidate) && $candidate !== 'null') {
+          return $candidate;
+        }
+      }
+    }
+    foreach (['oneOf', 'anyOf'] as $keyword) {
+      foreach ((array) ($info[$keyword] ?? []) as $alternative) {
+        if (is_array($alternative) && ($resolved = static::jsonSchemaType($alternative)) !== 'null') {
+          return $resolved;
+        }
+      }
+    }
+    return 'string';
+  }
+
 }
